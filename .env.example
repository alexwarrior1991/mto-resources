# Todo lo que la aplicacion lee del entorno esta en este fichero. Lo que va comentado tiene un valor
# por defecto en application*.yaml que sirve tal cual. Las variables del perfil 'test'
# (TEST_DATABASE_*) no estan aqui a proposito: las usa la suite, no el contenedor.

# Spring application
SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_DEFAULT=dev
SERVER_PORT=8080
# Puerto publicado en el host. 8089: el 8080 es mto-stock, el 8081 mto-configuration, el 8083
# mto-maintenance, el 8084 mto-users, el 8086 mto-notification, el 8087 y el 8088 mto-field.
APP_PORT=8089
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# La base vive en mto-platform, publicada en el host. Desde este contenedor se alcanza por
# host.docker.internal; desde el IDE, por localhost.
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/mto_resources
DATABASE_USERNAME=mto_resources_user
DATABASE_PASSWORD=mto_resources_password

# Conexiones del pool (Hikari). Con hilos virtuales (Tomcat, @Scheduled, listeners) es el limite real de
# concurrencia: la suma de los pools de todos los servicios e instancias tiene que quedar por debajo del
# max_connections (100) del PostgreSQL compartido de mto-platform. Las operaciones de fondo vivas no
# pasan de APP_OPERATIONS_MAX_ACTIVE en todo el despliegue (se cuentan en la base), para no comerse el pool.
DATABASE_POOL_MAX_SIZE=10
# SPRING_THREADS_VIRTUAL_ENABLED=true
# APP_OPERATIONS_MAX_ACTIVE=4
# Lo que espera una peticion con 'Prefer: respond-async' antes de contestar 202, y su tope con 'wait='.
# APP_OPERATIONS_DEFAULT_WAIT=5s
# APP_OPERATIONS_MAX_WAIT=10s

# Keycloak / OAuth2 resource server. La API valida los JWT que emite Keycloak. No hay cuenta de
# servicio: este servicio no llama a nadie.
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
KEYCLOAK_CLIENT_ID=mto-resources-api
KEYCLOAK_AUDIENCE=mto-resources-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# Publicar /swagger-ui y /v3/api-docs sin token. Cerrado en produccion.
APP_SECURITY_EXPOSE_API_DOCS=false

# RabbitMQ: el de mto-platform. Publica personas, equipos, vehiculos, instrumentos y avisos de caducidad en
# mto.resources.exchange y escucha los turnos de mto-maintenance en su propia cola
# (mto.resources.maintenance.queue, con DLX y DLQ).
SPRING_RABBITMQ_HOST=host.docker.internal
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=mto
SPRING_RABBITMQ_PASSWORD=mto
SPRING_RABBITMQ_VIRTUAL_HOST=/
APP_RABBITMQ_ENABLED=true
APP_RABBITMQ_MAINTENANCE_LISTENER_ENABLED=true
# APP_RABBITMQ_MAINTENANCE_EXCHANGE=mto.maintenance.exchange
# APP_RABBITMQ_MAINTENANCE_QUEUE=mto.resources.maintenance.queue
# APP_RABBITMQ_MAINTENANCE_ROUTING_KEY=mto.maintenance.shift.*
# APP_RABBITMQ_EVENTS_EXCHANGE=mto.resources.exchange
# Con APP_OUTBOX_ENABLED=false el outbox escribe y el relay no publica: los eventos esperan en la tabla.
# APP_OUTBOX_ENABLED=true

# El vigilante diario de caducidades: avisa de las cualificaciones, los documentos de los vehiculos y las
# calibraciones que caducan dentro de WARNING_DAYS dias o que ya caducaron. El cron va en UTC.
# APP_RESOURCES_EXPIRY_ENABLED=true
# APP_RESOURCES_EXPIRY_CRON=0 10 4 * * *
# APP_RESOURCES_EXPIRY_WARNING_DAYS=30

# Firma de los mensajes: el mismo secreto que el resto del dominio.
MESSAGING_SIGNATURE_SECRET=
MESSAGING_SIGNATURE_MODE=OPTIONAL

# Observabilidad
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces
# MTO_TRACING_ENABLED=true
# MTO_TRACING_SAMPLING_PROBABILITY=0.1
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus,outbox,republish
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_RABBIT_ENABLED=false
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
JAVA_OPTS=
